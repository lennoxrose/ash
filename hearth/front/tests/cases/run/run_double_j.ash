package t;

public class RunDouble {
    public static void main(String[] args) {
        double[] xs = {0.0, 1.0, 5.0, 3.14159 * 1.5 * 1.5, 0.1 + 0.2, 100.0, 1234567.0, 12345678.9, 0.001, 0.0001,
            1e21, 1.5e-7, -2.5, 7.0 / 3, 1e15, 123456789012.0, 0.5, 4.35 * 100, 9999999.0, 1.0E7, 0.123456789, 2.0 / 3,
            100.0 / 7, 1.0e-3, 123.456, 1.7976931348623157e308, 0.1 * 3, 1.1 * 1.1, 33.333333333333336, 1e23, 9.999999999999999e22, 0.1 + 0.7, 8.41e21, 5e-5, 9.999999e6, 99999.99999999999,
            5e-324, 1e-323, 1e-310, 2.2250738585072014e-308, 123456789e100, 4.35e-100, 6.02214076e23, 1e-6, 0.000123, 3e-5, 1e22, 1.5e300};
        for (double x : xs) {
            System.out.println(x);
        }
    }
}
