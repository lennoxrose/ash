# Build artifacts
*.o
/bin/
/dist/

# apm-installed dependencies (see ideas/ash_modules.md) -- fetched,
# never hand-edited, same spirit as node_modules/
@ash-modules/

# Compiled benchmark binaries (keep the .cpp sources, ignore the built outputs)
hearth/ashvm/benchmarks/fib_cpp
hearth/ashvm/benchmarks/loop_cpp
hearth/ashvm/benchmarks/countdown_cpp
hearth/ashvm/benchmarks/hashmap_cpp
hearth/ashvm/benchmarks/native_jit
hearth/pyre/benchmarks/*/run_benchmark
hearth/pyre/tests/matrix_multiply_test
hearth/pyre/tests/monte_carlo_test
hearth/pyre/tests/cuda_test
hearth/pyre/src/web/node_modules/
# Generated from src/shaders/*.comp by glslc -mfmt=c (pyre/Makefile) --
# the .comp source is tracked, the embedded-SPIR-V .h is not, same as
# any other object code.
hearth/pyre/src/H/backends/vulkan/*_spv.h

# OS / editor cruft
.DS_Store
*.swp
*~

# Private Ai Files
.claude
.agents
skills-lock.json
docs/*
!docs/RELEASING.md
!docs/MEMORY_SAFETY.md
spec/

# Private Notes
rundown.md
missing.md
test.ash
# nvcc dependency files list this machine's absolute CUDA install paths; generated by the build, never committed
hearth/pyre/src/D/backends/cuda/*.d
